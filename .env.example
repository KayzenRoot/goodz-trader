# ---------------------------------------------------------------------------
# Goodz Trader - example environment. Copy to .env and edit. Never commit .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info

# SQLite database file. Use an absolute path in Docker.
DATABASE_PATH=./.data/goodz.db

# 32+ character secret used to encrypt MEXC credentials and sign sessions.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# Optional dashboard password. If empty, the dashboard is open (localhost only).
# Always set this when exposing the app to a network.
AUTH_PASSWORD=

# Allowed browser origin for the API when web and API are served separately.
# # APP_ORIGIN=http://localhost:5173

# Set true when served over HTTPS. Leave false for localhost HTTP.
COOKIE_SECURE=false

# Trust X-Forwarded-* from a reverse proxy.
TRUST_PROXY=false

# Built web assets. In production the API serves the dashboard itself.
# WEB_DIST_PATH=apps/web/dist

# MEXC futures endpoints (override only if MEXC changes them).
MEXC_BASE_URL=https://contract.mexc.com
MEXC_WS_URL=wss://contract.mexc.com/edge

# Optional server-side credentials. The Settings UI is the recommended path.
# MEXC_API_KEY=
# MEXC_API_SECRET=

# Hard safety gate for live trading. Keep false until you have validated the
# bot in paper mode. Both this flag and the confirmation phrase are required.
LIVE_TRADING_ENABLED=false

# Seed deterministic demo trades on first boot (development/demo only).
SEED_DEMO=true

# Daily retention job. Trades and orders are never pruned.
MAINTENANCE_ENABLED=true
RETENTION_LOGS_DAYS=14
RETENTION_EQUITY_DAYS=90
RETENTION_AUDIT_DAYS=365

# Backup defaults (used by `pnpm backup`).
# BACKUP_DIR=./backups
# BACKUP_KEEP=14

# Prometheus exposition at /metrics. With no token, production allows only
# loopback scrapes. Set a 16+ char token when scraping through a proxy.
METRICS_ENABLED=true
# METRICS_TOKEN=

# Record market snapshots as JSONL for replay/backtest. Files rotate daily and
# are pruned after MARKET_RECORD_KEEP_DAYS. In Docker, use /data/market.
MARKET_RECORD_ENABLED=false
# MARKET_RECORD_DIR=./.data/market
# MARKET_RECORD_KEEP_DAYS=14
# MARKET_RECORD_MAX_FILE_MB=256
