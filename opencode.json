{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    "CONTRIBUTING.md",
    ".opencode/instructions/INSTRUCTIONS.md",
    ".opencode/instructions/PROJECT.md"
  ],
  "skills": {
    "paths": ["./skills"]
  },
  "agent": {
    "planner": {
      "description": "Planning specialist for complex features. Produces a bounded implementation blueprint with risks and tests.",
      "mode": "subagent",
      "prompt": "{file:.opencode/prompts/agents/planner.txt}",
      "tools": {
        "read": true,
        "grep": true,
        "glob": true,
        "bash": true,
        "write": false,
        "edit": false
      }
    },
    "architect": {
      "description": "Software architecture specialist for system design, boundaries and technical decisions.",
      "mode": "subagent",
      "prompt": "{file:.opencode/prompts/agents/architect.txt}",
      "tools": {
        "read": true,
        "grep": true,
        "glob": true,
        "bash": true,
        "write": false,
        "edit": false
      }
    },
    "code-reviewer": {
      "description": "Reviews code for correctness, safety, maintainability and test gaps. Use after writing or changing code.",
      "mode": "subagent",
      "prompt": "{file:.opencode/prompts/agents/code-reviewer.txt}",
      "tools": {
        "read": true,
        "grep": true,
        "glob": true,
        "bash": true,
        "write": false,
        "edit": false
      }
    },
    "security-reviewer": {
      "description": "Security review for auth, secrets, input validation, trading boundaries and supply chain.",
      "mode": "subagent",
      "prompt": "{file:.opencode/prompts/agents/security-reviewer.txt}",
      "tools": {
        "read": true,
        "grep": true,
        "glob": true,
        "bash": true,
        "write": true,
        "edit": true
      }
    },
    "tdd-guide": {
      "description": "TDD specialist enforcing failing-test-first and meaningful coverage.",
      "mode": "subagent",
      "prompt": "{file:.opencode/prompts/agents/tdd-guide.txt}",
      "tools": {
        "read": true,
        "grep": true,
        "glob": true,
        "bash": true,
        "write": true,
        "edit": true
      }
    },
    "e2e-runner": {
      "description": "Playwright E2E specialist for critical dashboard and bot-control flows.",
      "mode": "subagent",
      "prompt": "{file:.opencode/prompts/agents/e2e-runner.txt}",
      "tools": {
        "read": true,
        "grep": true,
        "glob": true,
        "bash": true,
        "write": true,
        "edit": true
      }
    },
    "build-error-resolver": {
      "description": "Fixes build and TypeScript errors with minimal diffs.",
      "mode": "subagent",
      "prompt": "{file:.opencode/prompts/agents/build-error-resolver.txt}",
      "tools": {
        "read": true,
        "grep": true,
        "glob": true,
        "bash": true,
        "write": true,
        "edit": true
      }
    },
    "doc-updater": {
      "description": "Updates documentation and codemaps to match the implementation.",
      "mode": "subagent",
      "prompt": "{file:.opencode/prompts/agents/doc-updater.txt}",
      "tools": {
        "read": true,
        "grep": true,
        "glob": true,
        "bash": true,
        "write": true,
        "edit": true
      }
    },
    "refactor-cleaner": {
      "description": "Removes dead code and consolidates duplicates without changing behavior.",
      "mode": "subagent",
      "prompt": "{file:.opencode/prompts/agents/refactor-cleaner.txt}",
      "tools": {
        "read": true,
        "grep": true,
        "glob": true,
        "bash": true,
        "write": true,
        "edit": true
      }
    },
    "database-reviewer": {
      "description": "Reviews SQLite schema, queries, indexes, migrations and data integrity.",
      "mode": "subagent",
      "prompt": "{file:.opencode/prompts/agents/database-reviewer.txt}",
      "tools": {
        "read": true,
        "grep": true,
        "glob": true,
        "bash": true,
        "write": true,
        "edit": true
      }
    }
  },
  "command": {
    "plan": {
      "description": "Create a bounded implementation plan for a complex feature",
      "template": "{file:.opencode/commands/plan.md}\n\n$ARGUMENTS",
      "agent": "planner",
      "subtask": true
    },
    "tdd": {
      "description": "Enforce failing-test-first workflow",
      "template": "{file:.opencode/commands/tdd.md}\n\n$ARGUMENTS",
      "agent": "tdd-guide",
      "subtask": true
    },
    "code-review": {
      "description": "Review the current diff for correctness, safety and test gaps",
      "template": "{file:.opencode/commands/code-review.md}\n\n$ARGUMENTS",
      "agent": "code-reviewer",
      "subtask": true
    },
    "security": {
      "description": "Run a security review of the current changes",
      "template": "{file:.opencode/commands/security.md}\n\n$ARGUMENTS",
      "agent": "security-reviewer",
      "subtask": true
    },
    "build-fix": {
      "description": "Fix build and TypeScript errors with minimal changes",
      "template": "{file:.opencode/commands/build-fix.md}\n\n$ARGUMENTS",
      "agent": "build-error-resolver",
      "subtask": true
    },
    "e2e": {
      "description": "Generate or run Playwright E2E tests",
      "template": "{file:.opencode/commands/e2e.md}\n\n$ARGUMENTS",
      "agent": "e2e-runner",
      "subtask": true
    },
    "refactor-clean": {
      "description": "Remove dead code and consolidate duplicates",
      "template": "{file:.opencode/commands/refactor-clean.md}\n\n$ARGUMENTS",
      "agent": "refactor-cleaner",
      "subtask": true
    },
    "verify": {
      "description": "Run the verification loop and report evidence",
      "template": "{file:.opencode/commands/verify.md}\n\n$ARGUMENTS"
    },
    "test-coverage": {
      "description": "Analyze coverage and identify meaningful gaps",
      "template": "{file:.opencode/commands/test-coverage.md}\n\n$ARGUMENTS",
      "agent": "tdd-guide",
      "subtask": true
    },
    "update-docs": {
      "description": "Reconcile documentation with the implementation",
      "template": "{file:.opencode/commands/update-docs.md}\n\n$ARGUMENTS",
      "agent": "doc-updater",
      "subtask": true
    },
    "checkpoint": {
      "description": "Save verification state and progress",
      "template": "{file:.opencode/commands/checkpoint.md}\n\n$ARGUMENTS"
    },
    "eval": {
      "description": "Run a task against explicit evaluation criteria",
      "template": "{file:.opencode/commands/eval.md}\n\n$ARGUMENTS"
    }
  }
}
